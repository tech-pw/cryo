# Copy to `.env` and fill in for your environment. Uses the CRYO_ prefix (see cryo/config.py).
# None of these are required to run Cryo against seeded/demo data -- they enable specific
# integrations that are off by default.

# --- Query telemetry ingestion ---
# Query performance, SLA P95 latency, lineage edges, and AutoComp benefit scores all depend on
# rows in cryo.query_logs. Ingestion is OFF by default. To enable polling a live Trino
# coordinator's system.runtime.queries table from the scheduler (checked hourly):
#
#   CRYO_TELEMETRY_INGEST_ON_STARTUP=true
#   CRYO_TELEMETRY_TRINO_URL=http://localhost:8080
#
# This requires the local dev datalake stack actually running (`./start-local.sh start` or
# `make up-datalake`) -- without it there's nothing listening on that URL to poll. For
# production, prefer a Trino event listener or query-log sidecar that POSTs to Cryo's
# /telemetry/ingest API instead of polling.
# CRYO_TELEMETRY_INGEST_ON_STARTUP=true
# CRYO_TELEMETRY_TRINO_URL=http://localhost:8080

# --- Table SLA/data-quality breach alerts ---
# Base URL of the web app, used to build "open in Cryo" deep links in breach alert emails.
# CRYO_WEB_APP_BASE_URL=http://127.0.0.1:5173
# How often to check owned/subscribed tables for new breaches (default: 1 hour).
# CRYO_TABLE_ALERT_DISPATCH_INTERVAL_HOURS=1
# Minimum time between repeat alerts for the same table (default: 24 hours).
# CRYO_TABLE_ALERT_COOLDOWN_HOURS=24

# --- Email delivery (SMTP) for reports and breach alerts ---
# CRYO_SMTP_HOST=smtp.example.com
# CRYO_SMTP_PORT=587
# CRYO_SMTP_USER=
# CRYO_SMTP_PASSWORD=
# CRYO_SMTP_FROM=cryo@example.com

# --- Slack notifications (daily reports + breach alerts) ---
# CRYO_SLACK_WEBHOOK_URL=
# CRYO_SLACK_CHANNEL=
