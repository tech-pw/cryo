FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# Runs as UID 101 and cannot bind privileged ports, so nginx.conf listens on 8080.
# 1.27-alpine (alpine 3.21.3) hadn't had a fresh Alpine base rebuild since 2025-06-23;
# confirmed live, 2026-10-12: Trivy found 41 fixable OS-package CVEs (2 critical) purely
# from that stale base layer. 1.29-alpine is current as of 2026-05.
FROM nginxinc/nginx-unprivileged:1.29-alpine@sha256:8059701048a6cc7d64e8ab2812a44be70161bfa9ecfc01d69e95b8ff2a648705

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

USER 101

EXPOSE 8080
