FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# Runs as UID 101 and cannot bind privileged ports, so nginx.conf listens on 8080.
# 1.27-alpine (alpine 3.21.3) hadn't had a fresh Alpine base rebuild since 2025-06-23 --
# confirmed live, 2026-10-12: Trivy found 41 fixable OS-package CVEs (2 critical).
# 1.29-alpine's current digest turned out to resolve to alpine 3.23.4 with MORE
# findings (43, 0 critical) -- a newer nginx minor doesn't guarantee a fresher Alpine
# rebuild. stable-alpine (pushed hours before this pin, 2026-10-12) had the fewest.
# Pinned by digest, not the mutable tag, same as elsewhere in this repo -- re-verify
# with `trivy image` before bumping this again; "newest tag" isn't a reliable proxy
# for "fewest CVEs" for this particular upstream image.
FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:0f5f7068c5f5bf7046dbf649a08810ec1693967a9f488b8ff3998be6dd34bf6c

COPY --from=build /app/dist /usr/share/nginx/html
# envsubst at start: NGINX_LOCAL_RESOLVERS from the pod's /etc/resolv.conf, and
# CRYO_API_UPSTREAM from Helm (API Service FQDN). Do not bake kube-dns here.
COPY nginx.conf /etc/nginx/templates/default.conf.template
RUN rm -f /etc/nginx/conf.d/default.conf

ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
ENV NGINX_ENVSUBST_FILTER="NGINX_LOCAL_RESOLVERS|CRYO_API_UPSTREAM"
ENV CRYO_API_UPSTREAM=http://cryo-api:8000

USER 101

EXPOSE 8080
